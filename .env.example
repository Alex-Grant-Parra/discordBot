# Discord bot token (required)
DISCORD_TOKEN=

# Folder containing gif files (optional, defaults to "gifs")
GIF_DIR=gifs

# Spotify application credentials from https://developer.spotify.com/dashboard (required for music)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Must match a Redirect URI registered on the Spotify app exactly.
# Spotify now requires the loopback IP literal, so use 127.0.0.1 rather than localhost.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Optional. Leave blank and the bot creates its own collaborative playlist on first login,
# then remembers the ID in the database. Set it to pin the bot to a specific playlist.
SPOTIFY_PLAYLIST_ID=

# Optional. SQLite file for the music feature (defaults to "music.db")
MUSIC_DB_PATH=music.db

# Optional. Seconds between playlist polls, clamped to the range 5 to 60 (defaults to 7)
MUSIC_POLL_SECONDS=7
